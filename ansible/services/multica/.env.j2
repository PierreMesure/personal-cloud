# Multica self-hosted configuration.
# See https://github.com/multica-ai/multica/blob/main/SELF_HOSTING.md

APP_ENV=production
MULTICA_IMAGE_TAG=v0.9.0

POSTGRES_DB=multica
POSTGRES_USER=multica
POSTGRES_PASSWORD={{ multica_db_password }}
DATABASE_URL=postgres://multica:{{ multica_db_password }}@multica_postgres:5432/multica?sslmode=disable

# Generate with: openssl rand -hex 32
JWT_SECRET={{ multica_jwt_secret }}

FRONTEND_ORIGIN=https://{{ multica_domain }}
CORS_ALLOWED_ORIGINS=https://{{ multica_domain }}
MULTICA_APP_URL=https://{{ multica_domain }}
MULTICA_PUBLIC_URL=https://{{ multica_api_domain }}
MULTICA_DAEMON_SERVER_URL=https://{{ multica_api_domain }}

# The frontend proxies /api, /auth, /uploads and /ws to the backend so browser
# authentication remains same-origin. The API hostname is for CLI/daemon access.
REMOTE_API_URL=http://multica_backend:8080
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
COOKIE_DOMAIN=

ALLOW_SIGNUP=true
RESEND_API_KEY={{ multica_resend_api_key | default('') }}
