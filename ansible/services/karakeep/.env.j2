# Karakeep Configuration
KARAKEEP_VERSION=release
NEXTAUTH_URL=https://{{ karakeep_domain }}
NEXTAUTH_SECRET={{ karakeep_nextauth_secret }}
MEILI_MASTER_KEY={{ karakeep_meili_master_key }}

# OpenRouter AI integration
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY={{ karakeep_openrouter_api_key }}
INFERENCE_TEXT_MODEL=openrouter/free
INFERENCE_IMAGE_MODEL=openrouter/free

# Recommended for local disks. Avoid this on network-attached database storage.
DB_WAL_MODE=true

# Disable public self-registration after the initial account is created.
DISABLE_SIGNUPS=true

# Optional production hardening
LOG_LEVEL=warning
